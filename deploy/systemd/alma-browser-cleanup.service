[Unit]
Description=Expire ALMA browser trash and reclaim unreferenced files
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=alma
Group=alma
WorkingDirectory=/srv/alma-duplication-tool
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=ALMA_UI_AUTO_QUEUE=0
EnvironmentFile=/etc/alma-duplication/browser-storage.env
ExecStart=/srv/alma-duplication-tool/.venv/bin/python -m flask --app alma_duplicate.ui.app:create_app purge-expired-browser-assessments
ExecStart=/srv/alma-duplication-tool/.venv/bin/python -m flask --app alma_duplicate.ui.app:create_app cleanup-browser-artifacts
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alma-duplication/browser-artifacts
